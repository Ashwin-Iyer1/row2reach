{
  "name": "Row_2_Reach",
  "version": "1.0.3",
  "main": "app.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ashwin-Iyer1/row2reach"
  },
  "build": {
    "extraResources": [
      "./extraResources/config.json"
    ],
    "extraFiles": [
      "extraResources"
    ]
  },
  "scripts": {
    "start": "electron app.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "buildMac": "electron-packager . --overwrite --platform=darwin --arch=arm64 --out=release-builds --icon=assets/icon.icns --executable-name=\"Row 2 Reach\"",
    "buildWin": "electron-packager . \"Row_2_Reach\" --overwrite --platform=win32 --out=release-builds --version-string.CompanyName=\"Row 2 Reach\" --version-string.FileDescription=\"Row 2 Reach Application\" --version-string.ProductName=\"Row 2 Reach\" --icon=assets/icon.png",
    "create-installer": "node build-installer.js"
  },
  "author": "Ashwin Iyer",
  "license": "ISC",
  "description": "Row 2 Reach Application",
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-packager": "^17.1.2",
    "electron-winstaller": "^5.4.0"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.25.1",
    "@azure/msal-node": "^3.8.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@types/papaparse": "^5.3.16",
    "dotenv": "^17.2.2",
    "electron-json-storage": "^4.6.0",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^5.1.0",
    "isomorphic-fetch": "^3.0.0",
    "papaparse": "^5.5.3",
    "update-electron-app": "^3.1.1"
  }
}
